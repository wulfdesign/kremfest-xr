# KremFest XR - Public Repository .gitignore

# Strictly Ignore Private Sanctuary and Sub-Repositories
private/
private/**
*_private*
*.private
*.secret

# Environment & Credentials
.env
.env.*
!.env.example
*.key
*.pem

# Python & System Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
